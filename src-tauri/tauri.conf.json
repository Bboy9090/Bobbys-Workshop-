{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BobFWTools",
  "version": "0.1.0",
  "identifier": "com.bobbyblanco.bobfwtools",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "BobFWTools — Android Tools for macOS",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 Bobby Blanco",
    "category": "Utilities",
    "shortDescription": "Android connectivity and diagnostics for macOS.",
    "longDescription": "BobFWTools provides professional Android device connectivity, MTP file transfer, ADB and Fastboot diagnostics, USB troubleshooting, device information, logging, and support workflows on macOS.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.mac.plist"
    }
  },
  "plugins": {}
}
