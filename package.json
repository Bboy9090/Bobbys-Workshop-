{
  "name": "bobfwtools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "kill": "fuser -k 5000/tcp",
    "build": "tsc -b --noCheck && vite build",
    "lint": "eslint .",
    "format:md": "npx -y prettier@3.3.3 --write \"**/*.md\" --ignore-path .gitignore",
    "format:md:check": "npx -y prettier@3.3.3 --check \"**/*.md\" --ignore-path .gitignore",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "test": "vitest run tests/bobfwtools-foundation.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run tests/server-smoke.test.js",
    "test:contract": "vitest run tests/api-contract.test.js",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:workflows": "node scripts/test-workflows.js",
    "test:trapdoor": "vitest run tests/trapdoor-api.test.js",
    "test:workflow": "vitest run tests/workflow-system.test.js",
    "test:all": "npm run test && npm run test:workflow && npm run test:trapdoor",
    "check:rust": "node scripts/check-rust.js",
    "check:android-tools": "node scripts/check-android-tools.js",
    "arsenal:status": "node scripts/dev-arsenal-status.js",
    "server:kill": "fuser -k 3001/tcp",
    "phoenix:dev": "cd phoenix-key && python3 main.py",
    "phoenix:build": "cd phoenix-key && python3 -m build",
    "bootforge:build": "cd backend/bootforge_usb && cargo build --release",
    "bootforge:test": "cd backend/bootforge_usb && cargo test",
    "tauri:dev": "tauri dev",
    "bundle:nodejs": "node scripts/bundle-nodejs.js",
    "bundle:server": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-server.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash scripts/bundle-server.sh', {stdio: 'inherit'})\"",
    "prepare:bundle": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundle.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash scripts/prepare-bundle.sh', {stdio: 'inherit'})\"",
    "bundle:fastapi": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-fastapi-backend.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash scripts/bundle-fastapi-backend.sh', {stdio: 'inherit'})\"",
    "tauri:build": "npm run build && npm run prepare:bundle && npm run bundle:fastapi && cargo tauri build && node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-server-to-release.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash -c \\\"cp -r src-tauri/bundle/resources/server src-tauri/target/release/\\\"', {stdio: 'inherit'})\"",
    "tauri:build:windows": "npm run build && npm run prepare:bundle && cargo tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:macos": "npm run build && tauri build --target universal-apple-darwin",
    "tauri:build:linux": "npm run build && npm run prepare:bundle && cargo tauri build --target x86_64-unknown-linux-gnu",
    "build:standalone": "node scripts/build-standalone.js",
    "build:windows": "node scripts/build-standalone.js --target=x86_64-pc-windows-msvc",
    "build:macos": "node scripts/build-standalone.js --target=x86_64-apple-darwin",
    "installer": "npm run build:standalone",
    "tauri:artifacts:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-tauri-windows-artifacts.ps1",
    "tauri:artifacts:windows:skipbuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-tauri-windows-artifacts.ps1 -SkipBuild",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-complete-installer.ps1",
    "build:complete": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-complete-bundle.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash scripts/build-complete-bundle.sh', {stdio: 'inherit'})\"",
    "build:complete:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-complete-bundle.ps1",
    "build:complete:macos": "bash scripts/build-complete-bundle.sh",
    "bundle:python": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-python-complete.ps1', {stdio: 'inherit'}) : require('child_process').execSync('bash scripts/bundle-python-complete.sh', {stdio: 'inherit'})\"",
    "verify:reality": "node scripts/verify-production-reality.mjs",
    "bobfw:check": "npm run verify:reality && npm run typecheck && npm run build && cargo check --manifest-path libs/bootforgeusb/Cargo.toml && cargo check --manifest-path src-tauri/Cargo.toml",
    "bobfw:test": "npm run test && cargo test --manifest-path libs/bootforgeusb/Cargo.toml",
    "tauri:build:macos:ci": "npm run build && tauri build --bundles app --target universal-apple-darwin",
    "tauri:build:macos:qualified:ci": "npm run build && tauri build --bundles app --target universal-apple-darwin --features qualified-flash",
    "test:legacy": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "ajv": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.26.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cors": "^2.8.6",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^4.22.3",
    "globals": "^17.0.0",
    "multer": "^1.4.5-lts.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "description": "BobFWTools \u2014 professional macOS Android device connectivity, MTP, ADB/Fastboot diagnostics, transfer, and support tooling."
}
