# Bobby's Workshop — Frontend Environment Variables
# Copy to .env and adjust URLs for your deployment

# Main workshop API (Express in src-tauri/resources/server, default port 3001)
VITE_API_BASE=http://127.0.0.1:3001

# Plugin Registry API base URL (required for Marketplace)
VITE_REGISTRY_API_URL=http://localhost:3001/api/plugins

# Firmware API base URL (search/check/download endpoints)
VITE_FIRMWARE_API_URL=http://localhost:3001/api/firmware

# BootForgeUSB service base URL (device scan/flash endpoints)
VITE_BOOTFORGE_API_URL=http://localhost:3001/api

# --- Backend (server) environment variables ---
# NOTE: The backend does NOT automatically read this file unless you export variables
# in your shell/session. Do NOT commit real secrets.
#
# Trapdoor / Secret Room API gate -- required by:
#   - the Express trapdoor-auth middleware (src-tauri/.../middleware/trapdoor-auth.js)
#   - the Python Phoenix Forge exploit API (backend/server.py)
# There is NO default value and NO bypass: if this is unset, every gated
# endpoint fails closed with 503/401 rather than allowing requests through.
# Generate one with: openssl rand -hex 32
SECRET_ROOM_PASSCODE=

# Admin API key for the Express trapdoor requireAdmin middleware. Also has no
# default -- unset means every admin-gated route returns 401.
ADMIN_API_KEY=

# API key + vault URL used by backend/server.py's Qualcomm OEM-unlock flow.
# Required: the handshake now raises instead of silently "succeeding" when
# this is missing or the vault call fails.
QUALCOMM_VAULT_API_KEY=
QUALCOMM_VAULT_URL=https://api.bobbysworkshop.com/v1/quantum/sign

# Comma-separated extra CORS origins the Python Phoenix Forge API should
# accept beyond the built-in localhost dev origins (Tauri/Vite defaults).
PHOENIX_FORGE_ALLOWED_ORIGINS=

# Host the Python Phoenix Forge API binds to when run standalone
# (python backend/server.py). Defaults to 127.0.0.1 -- every endpoint can
# trigger a real exploit/flash against connected hardware, so broadening
# this should be a deliberate choice.
PHOENIX_FORGE_HOST=127.0.0.1
